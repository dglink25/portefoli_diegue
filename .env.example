# ─────────────────────────────────────────
#  Base de données PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
DATABASE_URL=postgres://portfolio:change-me@localhost:5432/portfolio

# ─────────────────────────────────────────
#  Application Next.js
# ─────────────────────────────────────────
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─────────────────────────────────────────
#  Compte admin (utilisé par le seed)
# ─────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ─────────────────────────────────────────
#  SMTP — Envoi des messages de contact
#
#  Pour Gmail (recommandé) :
#  1. Activer l'authentification 2 facteurs
#     https://myaccount.google.com/security
#  2. Créer un "Mot de passe d'application"
#     https://myaccount.google.com/apppasswords
#     Catégorie : Mail / Autre (Portfolio)
#  3. Copier le mot de passe de 16 caractères ici
#
#  Si SMTP_PASS est vide ou "your_app_password_here",
#  les messages sont seulement sauvegardés en base de données.
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-email@gmail.com
SMTP_PASS=your_16_char_app_password
CONTACT_TO=votre-email@gmail.com
