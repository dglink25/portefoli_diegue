# syntax=docker/dockerfile:1
# ════════════════════════════════════════════════════════
#  Dockerfile de DÉVELOPPEMENT
#  - Cache npm via BuildKit mount
#  - Lance "npm run dev" avec hot-reload via volume monté
# ════════════════════════════════════════════════════════
FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./

RUN --mount=type=cache,target=/root/.npm \
    npm install --fetch-timeout 600000 --prefer-offline

COPY . .

# Créer le dossier uploads avec permissions larges
RUN mkdir -p /app/public/uploads && chmod -R 777 /app/public/uploads

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

CMD ["npm", "run", "dev"]
